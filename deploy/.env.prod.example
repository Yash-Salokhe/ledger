# Copy to deploy/.env.prod and fill in. Never commit the filled-in file.
DOMAIN=ledger.example.com

# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
COACH_DB_PASSWORD=
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Email (verification codes, magic links). Without a key, codes are only printed in the app logs.
RESEND_API_KEY=
EMAIL_FROM=Ledger <no-reply@ledger.example.com>

# Optional sign-in providers: their buttons are hidden until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

PASSWORD_BREACH_CHECK=on
