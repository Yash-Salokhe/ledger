{
  "name": "ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://app_login@localhost:5432/ledger} TEST_ADMIN_URL=${TEST_ADMIN_URL:-postgres://postgres@localhost:5432/ledger} vitest run tests"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
