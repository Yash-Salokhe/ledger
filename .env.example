# Copy to .env.local for development. Never commit real values.

# Migrations run as the database owner (the docker-compose user) and create the login roles below.
MIGRATION_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
APP_DB_PASSWORD=devpass
COACH_DB_PASSWORD=devpass
# The app connects as app_login, a member of `ledger_app`: no superuser, so RLS always applies.
DATABASE_URL=postgres://app_login:devpass@localhost:5432/ledger
# Ledger Coach / MCP connect as coach_login (`ledger_coach_ro`: read-only, coach.* views)
DATABASE_URL_READONLY=postgres://coach_login:devpass@localhost:5432/ledger

# Any random string of 32+ characters (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional providers (buttons hide when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Email (logs to the console when unset)
RESEND_API_KEY=
EMAIL_FROM="Ledger <no-reply@yourdomain.com>"

# openssl rand -base64 32 — encrypts broker API tokens at rest
TOKEN_ENCRYPTION_KEY=

# Breached-password check (needs internet). Keep "on" in production.
PASSWORD_BREACH_CHECK=on
