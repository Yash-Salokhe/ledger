# Copy to .env.local for development. Never commit real values.

# App connects as a role in `ledger_app` (RLS enforced). Migrations run as the owner.
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
# Ledger Coach / MCP connect as a role in `ledger_coach_ro` (read-only, coach.* views)
DATABASE_URL_READONLY=postgres://ledger_coach:ledger@localhost:5432/ledger

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional providers (buttons hide when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Email (logs to the console when unset)
RESEND_API_KEY=
EMAIL_FROM="Ledger <no-reply@yourdomain.com>"

# openssl rand -base64 32 — encrypts broker API tokens at rest
TOKEN_ENCRYPTION_KEY=
